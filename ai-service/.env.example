# MedAssist+ AI service configuration

# Server
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=5001
LOG_LEVEL=INFO
LANGUAGE=en

# Optional OpenAI-compatible LLM endpoint.
# Leave LLM_API_URL empty to use the deterministic offline agents.
# Groq (do not commit a real key; set it on the host):
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL=openai/gpt-oss-20b
# Llama 3.1 8B and Llama 3.3 70B are enterprise-only and return model_not_found.
# openai/gpt-oss-20b is the fast chat model. openai/gpt-oss-120b is the larger one.
# Local Ollama: LLM_API_URL=http://127.0.0.1:11434/v1/chat/completions
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# Stay under the API's 25s wait so a slow model falls back here instead of being cut off.
LLM_TIMEOUT_SECONDS=20