{
  "name": "medassist-backend",
  "version": "1.0.0",
  "description": "MedAssist+ backend API - AI healthcare navigation and management",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "seed": "tsx src/seed/seed.ts",
